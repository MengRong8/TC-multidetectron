# Optional: host path for backend image checkpoints
# Must contain cbm-encoder.pt and cbm-predictor.pt
CHECKPOINTS_IMAGE_DIR=./checkpoints/image

# Optional: host path for HuggingFace cache to avoid re-downloads
HF_CACHE_DIR=./.cache/huggingface

# Optional: HuggingFace token if needed by private/gated models
HF_TOKEN=

# Google Custom Search API (used by the crawler)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# LLM server used by data-generation scripts (Ollama)
LLM_HOST=localhost
LLM_API_URL=http://localhost:11434/api/generate
