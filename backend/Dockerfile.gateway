FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
 && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.gateway.txt /app/backend/requirements.gateway.txt
RUN pip install --upgrade pip && pip install -r /app/backend/requirements.gateway.txt

EXPOSE 5000

CMD ["python", "backend/gateway.py", "--host", "0.0.0.0", "--port", "5000"]
